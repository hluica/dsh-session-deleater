{
  "name": "@local/dsh-session-deleater",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Safely delete a local DeepSeek Harness session, its projection cache, workspace references, and optional media.",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "rebuild": "node scripts/build.mjs --force",
    "verify": "node scripts/verify.mjs",
    "clean": "node scripts/build.mjs --clean",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.3"
  }
}
